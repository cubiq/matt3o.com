---
import { render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import Figure from '../components/Figure.astro';
import Gallery from '../components/Gallery.astro';
import Video from '../components/Video.astro';
import Audio from '../components/Audio.astro';
import Button from '../components/Button.astro';
import { getPublishedPosts } from '../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // Posts are sorted newest-first: nextPost is newer (index - 1), prevPost is older (index + 1)
      nextPost: index > 0 ? posts[index - 1] : undefined,
      prevPost: index < posts.length - 1 ? posts[index + 1] : undefined,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post} prevPost={prevPost} nextPost={nextPost}>
  <Content
    components={{
      Figure,
      Gallery,
      Video,
      Audio,
      Button,
    }}
  />
</PostLayout>

