---
import type { BlogPost } from '../utils/posts';
import { formatDate, getReadingTime, getExcerpt } from '../utils/posts';
import { slugify } from '../consts';

interface Props {
  post: BlogPost;
  priority?: boolean;
}

const { post, priority = false } = Astro.props;
const { title, pubDate, poster, posterAlt, category, tags } = post.data;
const excerpt = getExcerpt(post);
const categorySlug = slugify(category);
const readTime = getReadingTime(post.body);
const postUrl = `/${post.id}/`;
---

<article class:list={['post-card', 'terminal-box', { 'has-poster': Boolean(poster), 'title-only': !poster }]}>
  <div class="terminal-box-header">
    <div class="card-header-left">
      <span class="terminal-dots" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
      <a href={`/categories/${categorySlug}`} class="cat-badge">
        {category}
      </a>
      <time datetime={pubDate.toISOString()} class="post-date">
        {formatDate(pubDate)}
      </time>
    </div>
    <span class="read-time">{readTime} min read</span>
  </div>

  {poster ? (
    <a href={postUrl} class="poster-link" tabindex="-1" aria-hidden="true">
      <div class="poster-frame">
        <img
          src={poster}
          alt={posterAlt || title}
          width="880"
          height="420"
          fetchpriority={priority ? 'high' : undefined}
          loading={priority ? undefined : 'lazy'}
          decoding="async"
        />
      </div>
    </a>
  ) : null}

  <div class="card-body">
    <h2 class="card-title">
      <a href={postUrl}>
        {!poster && <span class="title-prompt" aria-hidden="true">&gt;_ </span>}
        {title}
      </a>
    </h2>

    {excerpt && <p class="card-description">{excerpt}</p>}

    <div class="card-footer">
      <div class="card-tags">
        {tags.map((tag) => (
          <a href={`/tags/${slugify(tag)}`} class="tag-chip">
            {tag}
          </a>
        ))}
      </div>

      <a href={postUrl} class="read-more-link">
        cat {post.id}.md &rarr;
      </a>
    </div>
  </div>
</article>

<style>
  .post-card {
    transition: border-color 0.18s ease, transform 0.18s ease;
    overflow: hidden;
  }

  .post-card:hover {
    border-color: var(--accent-border);
  }

  .card-header-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .post-date {
    color: var(--text-secondary);
    font-size: 0.78rem;
  }

  .read-time {
    color: var(--text-muted);
    font-size: 0.76rem;
  }

  .poster-link {
    display: block;
    border-bottom: 1px solid var(--border-color);
    background-color: var(--bg-code);
    overflow: hidden;
  }

  .poster-frame {
    aspect-ratio: 21 / 9;
    max-height: 340px;
    width: 100%;
    overflow: hidden;
  }

  .poster-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.25s ease, filter 0.25s ease;
  }

  .post-card:hover .poster-frame img {
    transform: scale(1.015);
  }

  .card-body {
    padding: 1.25rem 1.35rem;
  }

  .post-card.title-only .card-body {
    padding: 1.45rem 1.35rem 1.25rem;
    background: linear-gradient(135deg, rgba(246, 196, 69, 0.04) 0%, transparent 65%);
  }

  .card-title {
    margin: 0 0 0.65rem;
    font-size: 1.35rem;
    line-height: 1.35;
  }

  .post-card.title-only .card-title {
    font-size: 1.5rem;
  }

  .title-prompt {
    color: var(--accent);
    font-weight: 700;
  }

  .card-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .card-title a:hover,
  .card-title a:focus-visible {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-border);
  }

  .card-description {
    margin: 0 0 1.15rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--border-subtle);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .read-more-link {
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--accent);
    margin-left: auto;
  }

  .read-more-link:hover {
    color: var(--accent-bright);
    text-decoration: underline;
  }
</style>
