---
// Native <dialog closedby="any"> lightbox for browsing single and gallery images
---

<dialog id="lightbox-dialog" closedby="any" aria-labelledby="lightbox-title" class="lightbox-modal">
  <div class="lightbox-shell">
    <div class="lightbox-header">
      <div class="lightbox-meta">
        <span class="lightbox-counter" id="lightbox-counter">[1/1]</span>
        <h2 id="lightbox-title" class="lightbox-heading">Image Preview</h2>
      </div>
      <div class="lightbox-controls">
        <button type="button" class="lb-btn" id="lightbox-prev" aria-label="Previous image (Left Arrow)">
          &larr; prev
        </button>
        <button type="button" class="lb-btn" id="lightbox-next" aria-label="Next image (Right Arrow)">
          next &rarr;
        </button>
        <form method="dialog" class="lb-close-form">
          <button type="submit" class="lb-btn lb-close-btn" autofocus aria-label="Close lightbox (Esc)">
            [x close]
          </button>
        </form>
      </div>
    </div>

    <div class="lightbox-stage">
      <img id="lightbox-img" src="" alt="" />
    </div>

    <div class="lightbox-footer">
      <p id="lightbox-caption" class="lightbox-caption"></p>
      <span class="lightbox-keys-hint">Use &larr; / &rarr; to navigate &middot; Esc or click outside to close</span>
    </div>
  </div>
</dialog>

<script>
  function initLightbox() {
    const dialog = document.getElementById('lightbox-dialog') as HTMLDialogElement | null;
    if (!dialog) return;

    const imgEl = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const captionEl = document.getElementById('lightbox-caption');
    const titleEl = document.getElementById('lightbox-title');
    const counterEl = document.getElementById('lightbox-counter');
    const prevBtn = document.getElementById('lightbox-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('lightbox-next') as HTMLButtonElement | null;

    const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox-item]'));
    if (triggers.length === 0) return;

    let currentIndex = 0;

    function updateSlide(index: number) {
      if (triggers.length === 0 || !imgEl) return;
      currentIndex = (index + triggers.length) % triggers.length;
      const trigger = triggers[currentIndex];
      const src = trigger.dataset.lightboxSrc || '';
      const alt = trigger.dataset.lightboxAlt || '';
      const caption = trigger.dataset.lightboxCaption || alt;

      imgEl.src = src;
      imgEl.alt = alt;
      if (captionEl) captionEl.textContent = caption;
      if (titleEl) titleEl.textContent = alt || 'Image Viewer';
      if (counterEl) counterEl.textContent = `[${currentIndex + 1}/${triggers.length}]`;

      const hasMultiple = triggers.length > 1;
      if (prevBtn) prevBtn.hidden = !hasMultiple;
      if (nextBtn) nextBtn.hidden = !hasMultiple;
    }

    triggers.forEach((trigger, idx) => {
      trigger.addEventListener('click', () => {
        updateSlide(idx);
        dialog.showModal();
      });
    });

    prevBtn?.addEventListener('click', () => updateSlide(currentIndex - 1));
    nextBtn?.addEventListener('click', () => updateSlide(currentIndex + 1));

    window.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        updateSlide(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        updateSlide(currentIndex + 1);
      }
    });

    // Fallback for browsers without native <dialog closedby="any"> support
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      let pressedOutside = false;
      const isOutside = (e: PointerEvent) => {
        const r = dialog.getBoundingClientRect();
        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
      };
      dialog.addEventListener('pointerdown', (e) => {
        pressedOutside = isOutside(e);
      });
      dialog.addEventListener('pointerup', (e) => {
        if (pressedOutside && isOutside(e)) {
          dialog.close();
        }
      });
    }
  }

  initLightbox();
</script>

<style>
  .lightbox-modal {
    padding: 0;
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-md);
    background-color: var(--bg-surface);
    color: var(--text-primary);
    width: min(94vw, 1100px);
    max-height: 92vh;
    margin: auto;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75);
  }

  /* Scope display to dialog[open] per modern-web-guidance */
  .lightbox-modal[open] {
    display: flex;
    flex-direction: column;
  }

  .lightbox-shell {
    display: flex;
    flex-direction: column;
    max-height: 92vh;
    width: 100%;
  }

  .lightbox-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    background-color: var(--bg-elevated);
    border-bottom: 1px solid var(--border-color);
  }

  .lightbox-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  .lightbox-counter {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.84rem;
  }

  .lightbox-heading {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lightbox-controls {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .lb-close-form {
    margin: 0;
  }

  .lb-btn {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-primary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .lb-btn:hover,
  .lb-btn:focus-visible {
    color: var(--accent-bright);
    border-color: var(--accent);
    background-color: var(--accent-dim);
  }

  .lb-close-btn {
    color: var(--accent);
    border-color: var(--accent-border);
  }

  .lightbox-stage {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-code);
    padding: 1rem;
    min-height: 280px;
    max-height: 74vh;
    overflow: auto;
  }

  .lightbox-stage img {
    max-width: 100%;
    max-height: 70vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .lightbox-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-color);
    font-size: 0.82rem;
  }

  .lightbox-caption {
    margin: 0;
    color: var(--text-secondary);
  }

  .lightbox-keys-hint {
    color: var(--text-muted);
    font-size: 0.74rem;
    margin-left: auto;
  }
</style>

