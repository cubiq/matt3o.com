---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  variant?: 'inline' | 'full';
  lightbox?: boolean;
  priority?: boolean;
}

const {
  src,
  alt,
  caption,
  variant = 'inline',
  lightbox = false,
  priority = false,
} = Astro.props;
---

<figure class:list={['post-figure', `variant-${variant}`]}>
  {lightbox ? (
    <button
      type="button"
      class="lightbox-trigger"
      data-lightbox-item
      data-lightbox-src={src}
      data-lightbox-alt={alt}
      data-lightbox-caption={caption || alt}
      aria-label={`Enlarge image: ${alt}`}
    >
      <img
        src={src}
        alt={alt}
        fetchpriority={priority ? 'high' : undefined}
        loading={priority ? undefined : 'lazy'}
        decoding="async"
      />
      <span class="zoom-badge" aria-hidden="true">[+ ENLARGE]</span>
    </button>
  ) : (
    <div class="figure-static">
      <img
        src={src}
        alt={alt}
        fetchpriority={priority ? 'high' : undefined}
        loading={priority ? undefined : 'lazy'}
        decoding="async"
      />
    </div>
  )}
  {caption && (
    <figcaption class="figure-caption">
      <span class="caption-prefix" aria-hidden="true">fig //</span> {caption}
    </figcaption>
  )}
</figure>

<style>
  .post-figure {
    margin: 1.85rem 0;
    padding: 0;
  }

  .post-figure.variant-inline {
    max-width: 100%;
  }

  /* Full width breaks out of prose column up to main container width */
  .post-figure.variant-full {
    width: min(var(--max-width), calc(100vw - 2.5rem));
  }

  .lightbox-trigger {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    background: var(--bg-code);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    cursor: zoom-in;
    overflow: hidden;
    text-align: left;
    transition: border-color 0.15s ease;
  }

  .lightbox-trigger:hover,
  .lightbox-trigger:focus-visible {
    border-color: var(--accent);
  }

  .figure-static {
    background: var(--bg-code);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .post-figure img {
    display: block;
    width: 100%;
    height: auto;
    border: none;
    border-radius: 0;
    transition: transform 0.25s ease;
  }

  .lightbox-trigger:hover img {
    transform: scale(1.01);
  }

  .zoom-badge {
    position: absolute;
    bottom: 0.6rem;
    right: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent);
    background-color: rgba(21, 24, 30, 0.88);
    border: 1px solid var(--accent-border);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    backdrop-filter: blur(4px);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .lightbox-trigger:hover .zoom-badge {
    background-color: var(--accent);
    color: #14171c;
  }

  .figure-caption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .caption-prefix {
    color: var(--accent);
    font-weight: 600;
  }
</style>

